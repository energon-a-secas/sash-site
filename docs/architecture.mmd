    app --> frame
    app --> state
    app --> events
    events --> wallet
    events --> profile
    wallet --> render
    profile --> render
    Badge --> badgejs
    Claim --> claimjs
    Embed --> embedjs
    ImportP --> importjs
    SendP --> sendjs
    Policy --> frame
    NotFound --> frame
    badgejs & claimjs & importjs & sendjs --> frame

    state --> convexjs
    badgejs & claimjs & embedjs & importjs & sendjs --> convexjs
    state --> auth
    claimjs & importjs & sendjs --> auth
    wallet & render --> avatar
    wallet & profile & badgejs & embedjs & importjs & sendjs --> insignia
    profile & embedjs & utils --> dom
    Pages --> header & footer & beacon

