    subgraph Outside["Outside services"]
        Clerk["clerk.neorgon.com\nOne production Clerk instance\npk_live meta on every page\nbut embed.html"]
        Credly["api.credly.com · www.credly.com\napi.badgr.io\nassertions and badge classes"]
        Enamel["enamel.neorgon.com\nThe studio: writes templates\nand templateVersions through\nthe same deployment"]
