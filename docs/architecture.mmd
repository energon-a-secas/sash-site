        ob["ob.ts (use node)\nob:credentialFor\nholder or admin only\nRS256 via node:crypto\nkid = ob/keys/1.json\nno key = degraded export"]
        seed["seed.ts\nensureNeorgonTemplates\n(internal), 15 templates"]
        crons["crons.ts\ndaily art:sweepOrphans"]
        DB[("Database\nprofiles · templates\ntemplateVersions · awards\nclaims · kudos · rateEvents")]
        Storage[("File storage\ntemplate art\nPNG / JPEG / WebP")]
    end

    convexjs -->|"POST /api/query\n/api/mutation · /api/action"| fns
    convexjs -.->|"convex@1.21.0/browser"| Esm["esm.sh"]
    fns --> rate
    fns --> importFetch
    fns --> ob
    fns --> DB
    fns --> Storage
    rate --> DB
    ob --> DB
    seed --> DB
    crons --> Storage

